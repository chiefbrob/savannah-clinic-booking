# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:55432/clinic
CLINIC_TIMEZONE=Africa/Nairobi
SLOT_MINUTES=30
MIN_BOOKING_LEAD_MINUTES=60
CORS_ORIGINS=*
ENVIRONMENT=development
SQL_ECHO=false

# Test database (used by pytest and the CI service container).
TEST_DATABASE_URL=postgresql+asyncpg://clinic:clinic@localhost:55432/clinic_test
